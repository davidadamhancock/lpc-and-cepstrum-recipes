{
	"name": "Parquet1",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage2",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"schemaname": {
				"type": "string"
			},
			"tablename": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Parquet",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(dataset().tablename,'=',formatDateTime(utcNow(), 'yyyyMMdd'))",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@concat(dataset().schemaname,'/',dataset().tablename,'=',formatDateTime(utcNow(), 'yyyyMMdd'))",
					"type": "Expression"
				},
				"fileSystem": "bronze"
			},
			"compressionCodec": "snappy"
		},
		"schema": []
	}
}